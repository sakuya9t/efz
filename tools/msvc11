#!/bin/bash
# Run a Visual C++ 2012 tool (cl, link, lib, ...) under wine in the efz-msvc71 container,
# with the include and library paths of a v110_xp build: VS2012's own, Windows SDK 7.1A,
# the DirectX SDK (June 2010) and boost 1.56.  EfzRevival 1.02h was built with this
# toolchain.
#   tools/msvc11 cl /c revival/EfzRevival/init.cpp
# The repo is mounted at /work and the current directory is preserved inside it.
# EFZ_TOOLCHAIN (default ~/tools/efz-toolchain) holds vs2012/, sdk71a/, dxsdk2010/ and
# boost156/, laid out by toolchain/setup-vs2012.sh.
# C:\Git is build/revival/c/Git, so a link can write its PDB where the originals' were,
# C:\Git\efz_2022\Release\, a path the binaries record. C:\Programming is the toolchain
# directory: the launcher was built against C:\Programming\protobuf-2.6.1\src, and the
# headers' __FILE__ strings in its code name that path.
# MSVC11_DIR runs the tool in another directory of the container instead, such as
# /opt/tc/protobuf-2.6.1/vsprojects (protobuf was built from there, and its __FILE__
# strings are relative to it); outputs must then be given as Z:\work\... paths.
set -e
tool=$1; shift
toolchain=${EFZ_TOOLCHAIN:-$HOME/tools/efz-toolchain}
repo=$(cd "$(dirname "$0")/.." && pwd)
case $PWD/ in
    "$repo"/*) sub=${PWD#"$repo"} ;;
    *) echo "tools/msvc11: run from inside $repo" >&2; exit 1 ;;
esac
# MSVC11_QUIET=1 drops the noise every compile prints: the SDK's macro redefinitions
# (C4005 between VS2012's sal.h and SDK 7.1A's), asio's _WIN32_WINNT notice and the
# echoed source name.
if [ -n "$MSVC11_QUIET" ]; then
    MSVC11_QUIET= "$0" "$tool" "$@" 2>&1 | sed -u \
        -e '/warning C4005/{N;d;}' -e '/^Please define _WIN32_WINNT/,/^Assuming _WIN32_WINNT/d' \
        -e '/^[A-Za-z0-9_.]*\.\(c\|cc\|cpp\)\r\?$/d'
    exit "${PIPESTATUS[0]}"
fi
exec docker run --rm -i --network none \
    -v "$repo:/work" -v "$toolchain:/opt/tc:ro" -w "${MSVC11_DIR:-/work$sub}" \
    -e 'INCLUDE=Z:\opt\tc\vs2012\include;Z:\opt\tc\sdk71a\Include;Z:\opt\tc\dxsdk2010\Include;Z:\opt\tc\boost156' \
    -e 'LIB=Z:\opt\tc\vs2012\lib;Z:\opt\tc\sdk71a\Lib;Z:\opt\tc\dxsdk2010\Lib;Z:\opt\tc\boost156\lib' \
    efz-msvc71 sh -c 'mkdir -p /work/build/revival/c/Git && c="$WINEPREFIX/drive_c" &&
        rm -rf "$c/Git" "$c/Programming" && ln -s /work/build/revival/c/Git "$c/Git" &&
        ln -s /opt/tc "$c/Programming" && exec wine "$@"' \
    sh "/opt/tc/vs2012/bin/$tool.exe" "$@"
